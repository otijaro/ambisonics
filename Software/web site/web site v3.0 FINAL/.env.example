# ==============================================================================
# AMBISONIC — PLANTILLA DE VARIABLES DE ENTORNO (.env.example)
# ==============================================================================
# Instrucciones:
# 1. Copia este archivo con el nombre '.env' en la raíz de 'pagina_github/':
#    cp .env.example .env   (Linux/macOS)
#    Copy-Item .env.example .env   (PowerShell)
# 2. Configura los valores correspondientes a tu entorno local o de producción.
# 3. NUNCA confirmes ni subas el archivo '.env' real a ningún repositorio público.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Base de Datos PostgreSQL (Obligatoria para usuarios y conversiones)
# ------------------------------------------------------------------------------
# Formato: postgresql://<usuario>:<contraseña>@<host>:<puerto>/<nombre_base_datos>
#
# Ejemplo local (PostgreSQL estándar en puerto 5432):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ambisonic_db
#
# Ejemplo con base de datos gestionada en la nube (Neon / Supabase):
# DATABASE_URL=postgresql://mi_usuario:mi_password@ep-ejemplo.sa-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ambisonic_db

# ------------------------------------------------------------------------------
# 2. Configuración CORS de FastAPI
# ------------------------------------------------------------------------------
# Lista de URLs origen permitidas para comunicarse con el backend (separadas por coma).
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 3. Concurrencia de Procesamiento DSP
# ------------------------------------------------------------------------------
# Número máximo de conversiones concurrentes en segundo plano (semáforo asyncio).
# Recomendado: 2 a 4 según los núcleos de CPU y memoria RAM disponibles.
MAX_CONCURRENT_DSP=2

# ------------------------------------------------------------------------------
# 4. Proxy Interno de Next.js hacia el Backend
# ------------------------------------------------------------------------------
# Dirección donde escucha el servidor Uvicorn / FastAPI.
INTERNAL_BACKEND_URL=http://127.0.0.1:8000

